<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- sequence 1 (bukan 5): Odoo membuka aplikasi dengan sequence terkecil saat login.
             Discuss (mail) juga 5 dan menang karena ID-nya lebih kecil. -->
        <menuitem
            id="menu_smartpolling_root"
            name="SmartPolling"
            sequence="1"/>

        <!-- ═══ Susunan menu atas (mengikuti alur kerja) ═══
             Dashboard | Wilayah &amp; Tim | Pemilih | Kegiatan | Konfigurasi
             Catatan: ID menu lama dipakai ulang (hanya nama/induk berubah) supaya update modul
             tidak menghapus record: menu_smartpolling_wilayah = "Wilayah &amp; Tim",
             menu_smartpolling_informasi = "Kegiatan". -->

        <!-- Dashboard: semua grup smartpolling (data otomatis ter-scope via ir.rule) -->
        <menuitem
            id="menu_smartpolling_dashboard"
            name="Dashboard"
            parent="menu_smartpolling_root"
            action="action_smartpolling_dashboard_client"
            groups="smartpolling.group_smartpolling_user"
            sequence="1"/>

        <!-- ─── Wilayah &amp; Tim: struktur lapangan (wilayah → TPS → relawan) ─── -->
        <menuitem
            id="menu_smartpolling_wilayah"
            name="Wilayah &amp; Tim"
            parent="menu_smartpolling_root"
            groups="smartpolling.group_smartpolling_user"
            sequence="10"/>
        <menuitem
            id="menu_smartpolling_kabupaten"
            name="Kabupaten/Kota"
            parent="menu_smartpolling_wilayah"
            action="action_smartpolling_kabupaten"
            groups="smartpolling.group_smartpolling_user"
            sequence="1"/>
        <menuitem
            id="menu_smartpolling_kecamatan"
            name="Kecamatan"
            parent="menu_smartpolling_wilayah"
            action="action_smartpolling_kecamatan"
            groups="smartpolling.group_smartpolling_user"
            sequence="2"/>
        <menuitem
            id="menu_smartpolling_desa"
            name="Desa/Kelurahan"
            parent="menu_smartpolling_wilayah"
            action="action_smartpolling_desa"
            groups="smartpolling.group_smartpolling_user"
            sequence="3"/>
        <menuitem
            id="menu_smartpolling_tps"
            name="TPS"
            parent="menu_smartpolling_wilayah"
            action="action_smartpolling_tps"
            groups="smartpolling.group_admin,smartpolling.group_relawan,smartpolling.group_viewer"
            sequence="4"/>
        <menuitem
            id="menu_smartpolling_relawan"
            name="Relawan"
            parent="menu_smartpolling_wilayah"
            action="action_smartpolling_relawan"
            groups="smartpolling.group_admin,smartpolling.group_relawan,smartpolling.group_viewer"
            sequence="5"/>

        <!-- ─── Pemilih: data DPT dan hasil survey-nya ─── -->
        <menuitem
            id="menu_smartpolling_pemilih"
            name="Pemilih"
            parent="menu_smartpolling_root"
            groups="smartpolling.group_admin,smartpolling.group_relawan,smartpolling.group_viewer"
            sequence="20"/>
        <menuitem
            id="menu_smartpolling_dpt"
            name="DPT"
            parent="menu_smartpolling_pemilih"
            action="action_smartpolling_dpt"
            groups="smartpolling.group_admin,smartpolling.group_relawan,smartpolling.group_viewer"
            sequence="1"/>
        <menuitem
            id="menu_smartpolling_voter"
            name="Survey"
            parent="menu_smartpolling_pemilih"
            action="action_smartpolling_voter"
            groups="smartpolling.group_admin,smartpolling.group_relawan,smartpolling.group_viewer"
            sequence="2"/>

        <!-- ─── Kegiatan: event penggalangan suara, agenda, dan berita (tampil ke petugas di /mobile) ─── -->
        <menuitem
            id="menu_smartpolling_informasi"
            name="Kegiatan"
            parent="menu_smartpolling_root"
            groups="smartpolling.group_admin,smartpolling.group_viewer"
            sequence="30"/>
        <menuitem
            id="menu_smartpolling_event"
            name="Event"
            parent="menu_smartpolling_informasi"
            action="action_smartpolling_event"
            groups="smartpolling.group_admin,smartpolling.group_viewer"
            sequence="1"/>
        <!-- Jalan pintas admin: pengajuan dana yang menunggu persetujuan + berita acara yang menunggu verifikasi -->
        <menuitem
            id="menu_smartpolling_event_pending"
            name="Menunggu Persetujuan"
            parent="menu_smartpolling_informasi"
            action="action_smartpolling_event_pending"
            groups="smartpolling.group_admin,smartpolling.group_viewer"
            sequence="2"/>
        <menuitem
            id="menu_smartpolling_agenda"
            name="Agenda"
            parent="menu_smartpolling_informasi"
            action="action_smartpolling_agenda"
            groups="smartpolling.group_admin,smartpolling.group_viewer"
            sequence="3"/>
        <menuitem
            id="menu_smartpolling_berita"
            name="Berita"
            parent="menu_smartpolling_informasi"
            action="action_smartpolling_berita"
            groups="smartpolling.group_admin,smartpolling.group_viewer"
            sequence="4"/>

        <!-- ─── Konfigurasi: API key AI = rahasia sistem → khusus administrator Settings Odoo ─── -->
        <menuitem
            id="menu_smartpolling_konfigurasi"
            name="Konfigurasi"
            parent="menu_smartpolling_root"
            groups="base.group_system"
            sequence="90"/>
        <menuitem
            id="menu_smartpolling_ai_settings"
            name="Pengaturan AI"
            parent="menu_smartpolling_konfigurasi"
            action="action_smartpolling_config_settings"
            groups="base.group_system"
            sequence="1"/>
    </data>
</odoo>
