<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tambahkan tab SmartPolling di form pengguna (Settings > Users) -->
        <record id="view_users_form_smartpolling" model="ir.ui.view">
            <field name="name">res.users.form.smartpolling</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='preferences']" position="after">
                    <page string="SmartPolling" name="smartpolling_config">
                        <group>
                            <group string="Relawan Terkait">
                                <field name="relawan_id"/>
                            </group>
                            <group string="Panduan">
                                <div colspan="2" style="color:#555; font-size:13px; line-height:1.7;">
                                    <p>
                                        <strong>Isi field <em>Relawan Terkait</em> untuk pengguna dengan grup Relawan:</strong>
                                    </p>
                                    <ul>
                                        <li><strong>Administrator</strong> — tidak perlu diisi, akses penuh.</li>
                                        <li><strong>Relawan</strong> — wajib isi <em>Relawan Terkait</em> agar data TPS/DPT/Survey miliknya terlihat.</li>
                                        <li><strong>Dashboard Viewer</strong> — tidak perlu diisi, akses baca semua data.</li>
                                    </ul>
                                </div>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
