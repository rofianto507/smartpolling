<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_smartpolling" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.smartpolling</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="SmartPolling" string="SmartPolling" name="smartpolling">
                    <block title="Analisis AI" name="smartpolling_ai_settings">
                        <setting string="Gemini API Key"
                                 help="Dipakai panel 'Analisis AI' di Dashboard SmartPolling untuk membuat laporan analisis otomatis. Yang dikirim ke Gemini hanya angka agregat (tanpa NIK, nama pemilih, atau nama relawan).">
                            <field name="smartpolling_gemini_api_key" password="True"/>
                            <div class="text-muted mt4">
                                <a href="https://aistudio.google.com/apikey" target="_blank">Dapatkan API Key di Google AI Studio</a>
                            </div>
                            <button name="action_test_smartpolling_gemini" string="Tes Koneksi" type="object" class="btn-secondary mt-2"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_smartpolling_config_settings" model="ir.actions.act_window">
        <field name="name">Pengaturan SmartPolling</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'smartpolling'}</field>
    </record>
</odoo>
