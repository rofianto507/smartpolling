<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_smartpolling_desa_list" model="ir.ui.view">
            <field name="name">desa.list.smartpolling</field>
            <field name="model">smartpolling.desa</field>
            <field name="arch" type="xml">
                <list string="Desa/Kelurahan">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="kecamatan_id"/>
                    <field name="kabupaten_id"/>
                    <field name="tps_count" string="Total TPS"/>
                    <field name="has_geometry" string="Ada Peta" widget="boolean" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_smartpolling_desa_form" model="ir.ui.view">
            <field name="name">desa.form.smartpolling</field>
            <field name="model">smartpolling.desa</field>
            <field name="arch" type="xml">
                <form string="Desa/Kelurahan">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tps" type="object" class="oe_stat_button" icon="fa-building">
                                <field name="tps_count" widget="statinfo" string="TPS"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="type"/>
                            </group>
                            <group>
                                <field name="kecamatan_id"/>
                                <field name="kabupaten_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Peta">
                                <field name="geometry" widget="text" string="Raw GeoJSON"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_smartpolling_desa_search" model="ir.ui.view">
            <field name="name">desa.search.smartpolling</field>
            <field name="model">smartpolling.desa</field>
            <field name="arch" type="xml">
                <search string="Cari Desa/Kelurahan">
                    <field name="name" string="Nama"/>
                    <field name="code" string="Kode"/>
                    <field name="kecamatan_id"/>
                    <field name="kabupaten_id"/>
                    <separator/>
                    <filter string="Kelurahan" name="filter_kelurahan" domain="[('type', '=', 'KELURAHAN')]"/>
                    <filter string="Desa" name="filter_desa" domain="[('type', '=', 'DESA')]"/>
                    <group>
                        <filter string="Kabupaten/Kota" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                        <filter string="Kecamatan" name="groupby_kecamatan" context="{'group_by': 'kecamatan_id'}"/>
                        <filter string="Tipe" name="groupby_type" context="{'group_by': 'type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_smartpolling_desa" model="ir.actions.act_window">
            <field name="name">Desa/Kelurahan</field>
            <field name="res_model">smartpolling.desa</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_smartpolling_desa_search"/>
        </record>
    </data>
</odoo>
