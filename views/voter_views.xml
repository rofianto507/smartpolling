<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_smartpolling_voter_list" model="ir.ui.view">
            <field name="name">voter.list.smartpolling</field>
            <field name="model">smartpolling.voter</field>
            <field name="arch" type="xml">
                <list string="Survey Preferensi Pemilih">
                    <field name="tanggal"/>
                    <field name="dpt_id"/>
                    <field name="nik"/>
                    <field name="kabupaten_id" optional="show"/>
                    <field name="kecamatan_id" optional="show"/>
                    <field name="desa_id" optional="show"/>
                    <field name="tps_id"/>
                    <field name="petugas_id"/>
                    <field name="event_id" optional="show"/>
                    <field name="pilihan" widget="badge"
                        decoration-success="pilihan == 'memilih'"
                        decoration-warning="pilihan == 'ragu_ragu'"
                        decoration-info="pilihan == 'belum_menentukan'"
                        decoration-danger="pilihan == 'tidak_memilih'"/>
                </list>
            </field>
        </record>

        <record id="view_smartpolling_voter_form" model="ir.ui.view">
            <field name="name">voter.form.smartpolling</field>
            <field name="model">smartpolling.voter</field>
            <field name="arch" type="xml">
                <form string="Survey Preferensi Pemilih">
                    <sheet>
                        <group>
                            <group>
                                <field name="dpt_id"/>
                                <field name="tanggal"/>
                                <field name="pilihan"/>
                                <field name="event_id"/>
                            </group>
                            <group>
                                <field name="foto" widget="image"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_smartpolling_voter_pivot" model="ir.ui.view">
            <field name="name">voter.pivot.smartpolling</field>
            <field name="model">smartpolling.voter</field>
            <field name="arch" type="xml">
                <pivot string="Survey Preferensi Pemilih">
                    <field name="kabupaten_id" type="row"/>
                    <field name="kecamatan_id" type="row"/>
                    <field name="pilihan" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="view_smartpolling_voter_graph" model="ir.ui.view">
            <field name="name">voter.graph.smartpolling</field>
            <field name="model">smartpolling.voter</field>
            <field name="arch" type="xml">
                <graph string="Survey Preferensi Pemilih" type="bar">
                    <field name="pilihan" type="row"/>
                </graph>
            </field>
        </record>

        <record id="view_smartpolling_voter_calendar" model="ir.ui.view">
            <field name="name">voter.calendar.smartpolling</field>
            <field name="model">smartpolling.voter</field>
            <field name="arch" type="xml">
                <calendar string="Survey Preferensi Pemilih" date_start="tanggal"
                    color="pilihan" mode="month" quick_create="0">
                    <field name="dpt_id"/>
                    <field name="pilihan"/>
                    <field name="tps_id"/>
                </calendar>
            </field>
        </record>

        <record id="view_smartpolling_voter_search" model="ir.ui.view">
            <field name="name">voter.search.smartpolling</field>
            <field name="model">smartpolling.voter</field>
            <field name="arch" type="xml">
                <search string="Cari Survey">
                    <field name="dpt_id"/>
                    <field name="nik"/>
                    <field name="tps_id"/>
                    <field name="desa_id"/>
                    <field name="kecamatan_id"/>
                    <field name="kabupaten_id"/>
                    <field name="petugas_id"/>
                    <field name="event_id"/>
                    <separator/>
                    <filter string="Survey Event" name="filter_event" domain="[('event_id', '!=', False)]"/>
                    <filter string="Memilih" name="filter_memilih" domain="[('pilihan', '=', 'memilih')]"/>
                    <filter string="Ragu-ragu" name="filter_ragu_ragu" domain="[('pilihan', '=', 'ragu_ragu')]"/>
                    <filter string="Belum Menentukan" name="filter_belum_menentukan" domain="[('pilihan', '=', 'belum_menentukan')]"/>
                    <filter string="Tidak Memilih" name="filter_tidak_memilih" domain="[('pilihan', '=', 'tidak_memilih')]"/>
                    <separator/>
                    <filter string="Tanggal Kunjungan" name="filter_tanggal" date="tanggal"/>
                    <group>
                        <filter string="Pilihan" name="groupby_pilihan" context="{'group_by': 'pilihan'}"/>
                        <filter string="TPS" name="groupby_tps" context="{'group_by': 'tps_id'}"/>
                        <filter string="Desa/Kelurahan" name="groupby_desa" context="{'group_by': 'desa_id'}"/>
                        <filter string="Kecamatan" name="groupby_kecamatan" context="{'group_by': 'kecamatan_id'}"/>
                        <filter string="Kabupaten/Kota" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                        <filter string="Petugas Pendata" name="groupby_petugas" context="{'group_by': 'petugas_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_smartpolling_voter" model="ir.actions.act_window">
            <field name="name">Survey Preferensi Pemilih</field>
            <field name="res_model">smartpolling.voter</field>
            <field name="view_mode">list,pivot,graph,calendar,form</field>
            <field name="search_view_id" ref="view_smartpolling_voter_search"/>
        </record>
    </data>
</odoo>
