<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_smartpolling_dpt_list" model="ir.ui.view">
            <field name="name">dpt.list.smartpolling</field>
            <field name="model">smartpolling.dpt</field>
            <field name="arch" type="xml">
                <list string="DPT">
                    <field name="nik"/>
                    <field name="nama"/>
                    <field name="jenis_kelamin"/>
                    <field name="tps_id"/>
                    <field name="kecamatan_id"/>
                    <field name="kabupaten_id"/>
                    <field name="petugas_id"/>
                    <field name="voter_count" string="Total Survey" sum="Total Survey"/>
                    <field name="pilihan_terakhir" optional="show"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'terverifikasi'"
                        decoration-info="state == 'baru'"
                        decoration-danger="state == 'ditolak'"/>
                </list>
            </field>
        </record>

        <record id="view_smartpolling_dpt_form" model="ir.ui.view">
            <field name="name">dpt.form.smartpolling</field>
            <field name="model">smartpolling.dpt</field>
            <field name="arch" type="xml">
                <form string="DPT">
                    <header>
                        <button name="action_set_terverifikasi" string="Verifikasi" type="object"
                            class="btn-primary" invisible="state == 'terverifikasi'" groups="smartpolling.group_admin"/>
                        <button name="action_set_ditolak" string="Tolak" type="object"
                            class="btn-danger" invisible="state == 'ditolak'" groups="smartpolling.group_admin"/>
                        <button name="action_set_baru" string="Kembalikan ke Baru" type="object"
                            class="btn-secondary" invisible="state == 'baru'" groups="smartpolling.group_admin"/>
                        <field name="state" widget="statusbar" statusbar_visible="baru,terverifikasi,ditolak"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_voter" type="object"
                                class="oe_stat_button" icon="fa-comments">
                                <field name="voter_count" widget="statinfo" string="Survey"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="nama" placeholder="Nama Pemilih"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="nik"/>
                                <field name="jenis_kelamin"/>
                                <field name="agama"/>
                                <field name="pekerjaan"/>
                                <field name="tempat_lahir"/>
                                <field name="tanggal_lahir"/>
                            </group>
                            <group>
                                <field name="hp"/>
                                <field name="alamat"/>
                                <field name="tps_id"/>
                                <field name="kecamatan_id" readonly="1"/>
                                <field name="kabupaten_id" readonly="1"/>
                                <field name="petugas_id"/>
                            </group>
                        </group>
                        <group string="Koordinat GPS">
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <field name="latitude" widget="smartpolling_latlng_map" class="w-100"
                            options="{'longitude_field': 'longitude'}" nolabel="1"/>
                        <notebook>
                            <page string="Riwayat Survey">
                                <field name="voter_ids">
                                    <list editable="bottom">
                                        <field name="tanggal"/>
                                        <field name="pilihan"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_smartpolling_dpt_pivot" model="ir.ui.view">
            <field name="name">dpt.pivot.smartpolling</field>
            <field name="model">smartpolling.dpt</field>
            <field name="arch" type="xml">
                <pivot string="DPT">
                    <field name="kabupaten_id" type="row"/>
                    <field name="kecamatan_id" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="view_smartpolling_dpt_graph" model="ir.ui.view">
            <field name="name">dpt.graph.smartpolling</field>
            <field name="model">smartpolling.dpt</field>
            <field name="arch" type="xml">
                <graph string="DPT" type="bar">
                    <field name="state" type="row"/>
                </graph>
            </field>
        </record>

        <record id="view_smartpolling_dpt_search" model="ir.ui.view">
            <field name="name">dpt.search.smartpolling</field>
            <field name="model">smartpolling.dpt</field>
            <field name="arch" type="xml">
                <search string="Cari DPT">
                    <field name="nik"/>
                    <field name="nama"/>
                    <field name="tps_id"/>
                    <field name="kecamatan_id"/>
                    <field name="kabupaten_id"/>
                    <field name="petugas_id"/>
                    <separator/>
                    <filter string="Baru" name="filter_baru" domain="[('state', '=', 'baru')]"/>
                    <filter string="Terverifikasi" name="filter_terverifikasi" domain="[('state', '=', 'terverifikasi')]"/>
                    <filter string="Ditolak" name="filter_ditolak" domain="[('state', '=', 'ditolak')]"/>
                    <separator/>
                    <filter string="Belum Survey" name="filter_belum_survey" domain="[('voter_count', '=', 0)]"/>
                    <separator/>
                    <filter string="Tanggal Input" name="filter_tanggal_input" date="create_date"/>
                    <group>
                        <filter string="TPS" name="groupby_tps" context="{'group_by': 'tps_id'}"/>
                        <filter string="Kecamatan" name="groupby_kecamatan" context="{'group_by': 'kecamatan_id'}"/>
                        <filter string="Kabupaten/Kota" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                        <filter string="Petugas Pendata" name="groupby_petugas" context="{'group_by': 'petugas_id'}"/>
                        <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_smartpolling_dpt" model="ir.actions.act_window">
            <field name="name">DPT</field>
            <field name="res_model">smartpolling.dpt</field>
            <field name="view_mode">list,pivot,graph,form</field>
            <field name="search_view_id" ref="view_smartpolling_dpt_search"/>
        </record>
    </data>
</odoo>
